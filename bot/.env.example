# ==========================================
# THE DULCAN DESIGN - DISCORD BOT CONFIGURACIÓN
# ==========================================

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_STAFF_ROLE_ID=your_discord_staff_role_id_here
DISCORD_ADMIN_ROLE_ID=your_discord_admin_role_id_here

# Bot Configuration
BOT_PREFIX=!

# Webhook Configuration (Web → Discord)
DISCORD_WEBHOOK_SECRET=your_webhook_secret_here
DISCORD_BOT_API_URL=http://localhost:5000/webhook
DISCORD_BOT_API_SECRET=your_bot_api_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Integration
WEBHOOK_URL=http://localhost:5000/webhook

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# ==========================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ==========================================

# 1. DISCORD_BOT_TOKEN
#    - Ve a https://discord.com/developers/applications
#    - Crea tu aplicación y bot
#    - Copia el token y pégalo aquí
#    - IMPORTANTE: Nunca compartas este token

# 2. DISCORD_CLIENT_ID
#    - En la misma página de Discord Developer Portal
#    - Copia el Application ID (CLIENT ID)

# 3. DISCORD_GUILD_ID
#    - Ve a tu servidor de Discord
#    - Activa "Modo desarrollador" en Configuración del servidor → Avanzado
#    - Click derecho en el nombre del servidor → "Copiar ID"

# 4. DISCORD_STAFF_ROLE_ID y DISCORD_ADMIN_ROLE_ID
#    - Después de ejecutar !setup-server, obtén los IDs de los roles creados
#    - Click derecho en el rol → "Copiar ID"

# 5. DISCORD_WEBHOOK_SECRET
#    - Genera un secreto seguro (ej: openssl rand -hex 32)
#    - Este secreto debe coincidir con el de la web

# 6. SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#    - Ve a https://supabase.com/dashboard/project/your-project/settings/api
#    - Copia la URL y las keys
#    - IMPORTANTE: Nunca uses service_role_key en el frontend

# 7. Web Integration
#    - La web enviará eventos al webhook configurado
#    - El bot procesará estos eventos y enviará notificaciones a Discord

# ==========================================
# SEGURIDAD
# ==========================================

# - Nunca subas este archivo .env al repositorio
# - Usa .env.example como template
# - Los tokens deben ser regenerados si se exponen
# - Limita los permisos del bot a lo necesario
# - Usa secrets seguros y rotalos periódicamente
