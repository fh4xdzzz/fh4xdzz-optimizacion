# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://wbkgesmnyjnomctdvxqb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication Mode
# Options: 'demo' (localStorage, development) or 'supabase' (real authentication, production)
NEXT_PUBLIC_AUTH_MODE=demo

# Nota: Reemplaza 'your_supabase_anon_key' y 'your_supabase_service_role_key' con tus credenciales reales
# Para producción, cambia NEXT_PUBLIC_AUTH_MODE a 'supabase'
# Los scripts SQL en database/ deben ejecutarse en el SQL Editor de Supabase en orden:
# 1. 01_users.sql (requiere Authentication habilitado primero)
# 2. 02_services.sql
# 3. 03_orders.sql
# 4. 04_tickets.sql
# 5. 05_testimonials.sql
# 6. 06_business_settings.sql
# 7. 07_security_functions.sql (ejecutar después de los scripts anteriores para corregir RLS)

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_STAFF_ROLE_ID=your_discord_staff_role_id
DISCORD_ADMIN_ROLE_ID=your_discord_admin_role_id

# Discord OAuth2 (for web integration)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/EDaCnZgC6T

