<Window x:Class="AetherBoost.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AetherBoost" Width="1180" Height="760" MinWidth="960" MinHeight="620" Background="{StaticResource WindowBrush}" Foreground="#F5F7FF" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="AetherBoost" FontSize="32" FontWeight="Bold"/><TextBlock Text="Optimización segura para gaming competitivo" Foreground="#AAB1C8" Margin="0,5,0,24"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" Margin="0,0,20,0"><StackPanel>
        <Button Content="Resumen" Height="44" Margin="0,0,0,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
        <Button Content="Diagnóstico" Height="44" Margin="0,0,0,8"/>
        <Button Content="Perfiles por juego" Height="44" Margin="0,0,0,8"/>
        <Button Content="Historial y rollback" Height="44" Margin="0,0,0,8"/>
        <Button Content="Configuración" Height="44"/>
      </StackPanel></Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,18"><StackPanel>
          <TextBlock Text="Listo para analizar tu PC" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Primero recopilaremos información de hardware y rendimiento. No se aplicará ningún cambio sin mostrarte el plan." Foreground="#AAB1C8" TextWrapping="Wrap" Margin="0,8,0,18"/><Button Content="Ejecutar diagnóstico seguro" Width="230" Height="42" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Click="RunDiagnostic_Click"/></StackPanel></Border>
        <UniformGrid Columns="3"><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU" Foreground="#AAB1C8"/><TextBlock Text="Pendiente" FontSize="20" Margin="0,8,0,0"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="GPU" Foreground="#AAB1C8"/><TextBlock Text="Pendiente" FontSize="20" Margin="0,8,0,0"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20"><StackPanel><TextBlock Text="RAM" Foreground="#AAB1C8"/><TextBlock Text="Pendiente" FontSize="20" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
        <TextBlock x:Name="StatusText" Text="Las acciones sensibles tendrán vista previa, registro y rollback." Foreground="#AAB1C8" Margin="0,22,0,0"/>
      </StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
